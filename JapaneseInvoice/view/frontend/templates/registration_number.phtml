<?php /** @var $block \CommunityEngineering\JapaneseInvoice\Block\Info\Order */?>
<?php /** @var $escaper \Magento\Framework\Escaper */?>

<div class="store-info">
    <p><?= $escaper->escapeHtml(__('(Publisher)'))?></p>
    <?php if($block->getStoreZip()) :?>
        <p class="zip-code"><span>〒</span><?= $escaper->escapeHtml($block->getStoreZip()) ?></p>
    <?php endif;?>
    <?php if($block->getStoreAddress()) :?>
        <p class="address"><?= $escaper->escapeHtml($block->getStoreAddress()) ?></p>
    <?php endif;?>
    <?php if($block->getStoreName()) :?>
        <p class="store-name"><?= $escaper->escapeHtml($block->getStoreName()) ?></p>
    <?php endif;?>
    <?php if($block->canShow()):?>
        <div class="registration-number">
            <?=$escaper->escapeHtml(__('Registration Number:'))?><?=$escaper->escapeHtml($block->getRegistrationNumber())?>
        </div>
    <?php endif;?>
</div>
