<?php /** @var $block \CommunityEngineering\JapaneseInvoice\Block\Sales\Order\Subtotal */?>
<?php /** @var $escaper \Magento\Framework\Escaper */?>
<?php $totals = $block->getTotals();?>
<?php /** @var $order \Magento\Sales\Model\Order */?>
<?php $order  = $block->getOrder();?>
<?php foreach ($totals as $rate => $total):?>
    <tr class="subtotals">
        <th class="mark" colspan="6" scope="row">
            <?=__('Subtotal for tax rate %1', $rate)?>
        </th>
        <td class="amount">
            <span>
                <?= $order->formatPrice($total['total']) ?>
            </span>
        </td>
    </tr>
    <tr class="tax">
        <th class="mark" colspan="6" scope="row">
            <?=__('Tax amount(%1)', $rate)?>
        </th>
        <td class="amount">
            <span>
                <?= $order->formatPrice($total['tax_amount']) ?>
            </span>
        </td>
    </tr>
<?php endforeach;?>
<tr class="reduction-info">
    <td class="mark" colspan="7"><?=$escaper->escapeHtml(__('* is reducted tax rate item.'))?></td>
</tr>
