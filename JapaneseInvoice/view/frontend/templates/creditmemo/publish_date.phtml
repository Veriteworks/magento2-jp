<?php /** @var $block \Magento\Sales\Block\Order\Info */?>
<?php /** @var $escaper \Magento\Framework\Escaper */?>
<?php
$order = $block->getOrder();
$id = $order->getIncrementId();
$actualOrder = $order->loadByIncrementId($id);
$creditmemo = $actualOrder->getCreditmemosCollection();
?>
<div class="creditmemo-publish-date">
    <?php foreach ($creditmemo as $item):?>
    <span class="label">
        <?=$escaper->escapeHtml(__('Publish Date:'))?>
    </span>
    <span>
        <?=$escaper->escapeHtml($block->formatDate($item['created_at'], \IntlDateFormatter::LONG))?>
    </span>
    <?php endforeach;?>
</div>
