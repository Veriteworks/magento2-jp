<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="page.main.title">
            <block class="CommunityEngineering\JapaneseInvoice\Block\Info\Order" name="registration_number" after="order.date" template="CommunityEngineering_JapaneseInvoice::registration_number.phtml"/>
        </referenceContainer>
        <referenceBlock name="invoice_totals">
            <arguments>
                <argument name="label_properties" xsi:type="string">colspan="5" class="mark"</argument>
                <argument name="value_properties" xsi:type="string">class="amount"</argument>
            </arguments>
            <referenceBlock name="tax" remove="true"/>
            <block class="CommunityEngineering\JapaneseInvoice\Block\Sales\Invoice\Subtotal" name="invoice_subtotal" template="CommunityEngineering_JapaneseInvoice::subtotal.phtml" after="-"/>
        </referenceBlock>
        <referenceBlock name="additional.product.info">
            <block class="CommunityEngineering\JapaneseInvoice\Block\Sales\Order\ReductionRateSign" name="reduction.rate.sign" template="CommunityEngineering_JapaneseInvoice::reduction_rate_sign.phtml"/>
        </referenceBlock>
        <referenceBlock name="invoice_items" template="CommunityEngineering_JapaneseInvoice::invoice/items.phtml" />
    </body>
</page>
