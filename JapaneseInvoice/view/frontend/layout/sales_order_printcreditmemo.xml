<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="page.main.title">
            <block class="Magento\Sales\Block\Order\Info" name="publish_date" before="order.status" template="CommunityEngineering_JapaneseInvoice::creditmemo/publish_date.phtml"/>
            <block class="Magento\Sales\Block\Order\Info" name="shipping_date" after="order.date" template="CommunityEngineering_JapaneseInvoice::shipment_date.phtml"/>
            <block class="CommunityEngineering\JapaneseInvoice\Block\Info\Order" name="registration_number" after="shipping_date" template="CommunityEngineering_JapaneseInvoice::registration_number.phtml"/>
        </referenceContainer>
        <referenceBlock name="creditmemo_totals">
            <arguments>
                <argument name="label_properties" xsi:type="string">colspan="7" class="mark"</argument>
                <argument name="value_properties" xsi:type="string">class="amount"</argument>
            </arguments>
            <referenceBlock name="tax" remove="true"/>
            <block class="CommunityEngineering\JapaneseInvoice\Block\Sales\Creditmemo\Subtotal" name="creditmemo_subtotal" template="CommunityEngineering_JapaneseInvoice::creditmemo/subtotal.phtml" after="-"/>
        </referenceBlock>
        <referenceBlock name="additional.product.info">
            <block class="CommunityEngineering\JapaneseInvoice\Block\Sales\Order\ReductionRateSign" name="reduction.rate.sign" template="CommunityEngineering_JapaneseInvoice::reduction_rate_sign.phtml"/>
        </referenceBlock>
        <referenceBlock name="sales.order.print.creditmemo" template="CommunityEngineering_JapaneseInvoice::print/creditmemo.phtml" />
    </body>
</page>
